Package: PipeMaster
Type: Package
Title: Coalescent Simulation and Demographic Inference with ABC and Neural Networks
Version: 2.0.0
Date: 2026-05-27
Authors@R: c(person("Marcelo", "Gehara", email = "marcelo.gehara@gmail.com", role = c("aut", "cre")),
